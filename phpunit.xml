<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            SENGAJA BUKAN SQLite (:memory:) — banyak migrasi (73 file)
            pakai DB::statement("ALTER TABLE ... MODIFY COLUMN ... ENUM(...)")
            sintaks MySQL murni yang tidak didukung SQLite sama sekali, jadi
            migrate:fresh akan gagal total kalau dipaksa SQLite.

            Database TERPISAH dari database aplikasi asli (lihat .env) —
            ditemukan 2026-09-21 bahwa sebelum baris ini ditambahkan, tidak
            ada isolasi test database sama sekali, jadi `php artisan test`
            diam-diam menjalankan RefreshDatabase (migrate:fresh) ke
            database MySQL yang sama dengan yang dipakai aplikasi beneran —
            menghapus SELURUH data setiap kali test dijalankan. Sebelum
            deploy config ini, database `ginnva_testing` (atau nama lain
            yang dipakai) HARUS sudah dibuat manual di server & user MySQL
            di .env harus punya akses ke situ juga.
        -->
        <env name="DB_DATABASE" value="ginnva_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
