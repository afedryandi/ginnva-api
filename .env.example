APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq API — untuk chatbot Asisten Ginnva (model llama-3.1-8b-instant)
# Dapatkan dari: console.groq.com/keys
GROQ_API_KEY=

# API kantor pusat China — wajib diminta ke tim China. Tidak ada fallback
# aman kalau kosong (beda dari WHATSAPP_* di bawah), jadi integrasi
# ke China akan gagal diam-diam tanpa var ini terisi.
CHINA_API_URL=
CHINA_API_SECRET_KEY=

# WhatsApp Business Cloud API (Meta) — reminder servis berkala. Kalau
# dikosongkan, WhatsAppService diam-diam skip kirim (reminder Push/Email
# tetap jalan) — lihat config/services.php untuk detail.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_SERVICE_REMINDER=service_reminder
WHATSAPP_TEMPLATE_LANG=id

# Firebase Cloud Messaging — untuk push notification
# Dapatkan dari: Firebase Console → Project Settings → Cloud Messaging → Server key
FCM_SERVER_KEY=

# Path ke Service Account JSON Firebase (opsional — sudah ada default aman
# di config/services.php: storage/app/firebase/service-account.json)
# FCM_CREDENTIALS_PATH=

# Sentry — error tracking. Kosongkan untuk menonaktifkan.
# Dapatkan dari: sentry.io → Project Settings → Client Keys (DSN)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# JWT (guard 'customer' & 'api' — dipakai bersama, lihat config/jwt.php).
# Default Laravel/tymon cuma 60 MENIT kalau var ini kosong — terlalu
# pendek untuk mobile app konsumen (customer browsing/isi form booking
# gampang lewat dari 1 jam) dan TIDAK ada refresh-token mechanism di app
# untuk memperpanjang otomatis, jadi begitu lewat TTL, aksi apa pun yang
# butuh login (submit booking, dst) mendadak gagal "Unauthenticated"
# walau tampilan app masih terlihat seperti sudah login. 43200 menit = 30 hari.
JWT_TTL=43200
