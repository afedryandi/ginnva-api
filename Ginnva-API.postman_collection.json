{
  "info": {
    "name": "Ginnva API",
    "description": "Dokumentasi lengkap REST API Ginnva (ginnva-api, Laravel) — dipakai oleh ginnva-web (Next.js) dan ginnva-mobile (Expo). Semua endpoint di /api/*. Response error selalu berbentuk { success: false, message, errors? } (lihat bootstrap/app.php exception handler).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://api.ginnva.id", "type": "string" },
    { "key": "customer_token", "value": "", "type": "string", "description": "JWT dari POST /customer/auth/verify-otp, guard 'customer'" },
    { "key": "staff_token", "value": "", "type": "string", "description": "JWT dari POST /staff/auth/login, guard 'api'" }
  ],
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List Carousels",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/carousels", "host": ["{{base_url}}"], "path": ["api", "carousels"] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"data\": [\n    { \"id\": 1, \"title\": \"Promo Kaca Film\", \"subtitle\": \"Diskon 20%\", \"image\": \"https://api.ginnva.id/storage/carousels/x.jpg\", \"link_url\": \"https://ginnva.id/promo\" }\n  ]\n}" }]
        },
        {
          "name": "List Materials (brosur)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/materials", "host": ["{{base_url}}"], "path": ["api", "materials"] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"data\": [\n    { \"id\": 1, \"name\": \"PPF\", \"materials\": [ { \"id\": 1, \"name\": \"Brosur PPF\", \"file_type\": \"pdf\", \"file_size\": \"2.3 MB\", \"url\": \"https://api.ginnva.id/storage/materials/x.pdf\" } ] }\n  ]\n}" }]
        },
        {
          "name": "Detect Role (staff/customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/detect-role", "host": ["{{base_url}}"], "path": ["api", "auth", "detect-role"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"role\": \"customer\" }" }]
        },
        {
          "name": "List Stores",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/stores?city=Tangerang", "host": ["{{base_url}}"], "path": ["api", "stores"], "query": [{ "key": "city", "value": "Tangerang", "description": "opsional" }] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": [ { \"id\": 1, \"name\": \"Ginnva PIK\", \"city\": \"Tangerang\", \"address\": \"...\", \"phone\": \"...\", \"is_active\": true } ]\n}" }]
        },
        {
          "name": "Store Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/stores/1", "host": ["{{base_url}}"], "path": ["api", "stores", "1"] }
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"data\": { \"id\": 1, \"name\": \"Ginnva PIK\", \"city\": \"Tangerang\", \"address\": \"...\" } }" },
            { "name": "404 Not Found", "code": 404, "body": "{ \"success\": false, \"message\": \"Toko tidak ditemukan.\" }" }
          ]
        },
        {
          "name": "Store Blocked Dates",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/stores/1/blocked-dates", "host": ["{{base_url}}"], "path": ["api", "stores", "1", "blocked-dates"] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"data\": [\"2026-07-15\", \"2026-07-20\"] }" }]
        },
        {
          "name": "List News",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/news?limit=10", "host": ["{{base_url}}"], "path": ["api", "news"], "query": [{ "key": "limit", "value": "10", "description": "opsional" }] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": [ { \"id\": 1, \"title\": \"Ginnva Buka Cabang Baru\", \"slug\": \"ginnva-buka-cabang\", \"excerpt\": \"...\", \"cover_image\": \"https://api.ginnva.id/storage/news/x.jpg\", \"source_url\": null, \"published_at\": \"2026-07-01T00:00:00.000000Z\" } ]\n}" }]
        },
        {
          "name": "News Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/news/ginnva-buka-cabang-baru", "host": ["{{base_url}}"], "path": ["api", "news", "ginnva-buka-cabang-baru"] }
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"data\": { \"id\": 1, \"title\": \"...\", \"slug\": \"...\", \"content\": \"<p>full html...</p>\", \"cover_image\": \"...\", \"published_at\": \"...\" } }" },
            { "name": "404 Not Found", "code": 404, "body": "{ \"success\": false, \"message\": \"Berita tidak ditemukan.\" }" }
          ]
        },
        {
          "name": "List Case Studies",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/case-studies?product_type=ppf", "host": ["{{base_url}}"], "path": ["api", "case-studies"], "query": [{ "key": "product_type", "value": "ppf", "description": "opsional: window_film|ppf|color_change" }] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": [ { \"id\": 1, \"title\": \"Toyota Alphard PPF\", \"short_title\": \"Alphard\", \"image\": \"...\", \"vehicle\": { \"id\": 1, \"brand\": \"Toyota\", \"model\": \"Alphard\" }, \"film_product\": { \"id\": 1, \"name\": \"Black Crystal\", \"product_type\": \"ppf\" }, \"sort_order\": 1 } ]\n}" }]
        },
        {
          "name": "List Job Openings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/job-openings", "host": ["{{base_url}}"], "path": ["api", "job-openings"] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": [ { \"id\": 1, \"title\": \"Sales Executive\", \"department\": \"Sales\", \"location\": \"Jakarta\", \"type\": \"full_time\", \"description\": \"...\", \"requirements\": [\"Min D3\", \"Pengalaman 1 tahun\"] } ]\n}" }]
        },
        {
          "name": "Chat (Asisten AI)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/chat", "host": ["{{base_url}}"], "path": ["api", "chat"] },
            "body": { "mode": "raw", "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Berapa lama garansi PPF?\" }\n  ]\n}" }
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"reply\": \"Garansi PPF Ginnva berlaku hingga 8 tahun tergantung seri produk...\" }" },
            { "name": "422 Validation", "code": 422, "body": "{ \"success\": false, \"message\": \"Pesan tidak valid.\" }" },
            { "name": "502 Upstream Error", "code": 502, "body": "{ \"success\": false, \"message\": \"Asisten sedang tidak tersedia. Silakan coba lagi.\" }" }
          ]
        }
      ]
    },
    {
      "name": "Warranty",
      "item": [
        {
          "name": "Submit Warranty Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/warranty/submit", "host": ["{{base_url}}"], "path": ["api", "warranty", "submit"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Budi Santoso\",\n  \"phone_number\": \"081234567890\",\n  \"car_plate\": \"B 1234 XY\",\n  \"car_type\": \"Toyota Avanza\",\n  \"product_series\": \"Nano-Ceramic\",\n  \"installation_date\": \"2026-07-01\",\n  \"expiry_date\": \"2034-07-01\",\n  \"dealer_name\": \"Ginnva PIK\"\n}"
            }
          },
          "response": [
            { "name": "201 Created", "code": 201, "body": "{ \"success\": true, \"message\": \"Data garansi berhasil didaftarkan dan sedang menunggu review admin.\", \"data\": { \"id\": 1, \"warranty_code\": \"GNV-ABC1234XYZ\", \"status\": \"active\", \"review_status\": \"pending_review\" } }" },
            { "name": "422 Validation", "code": 422, "body": "{ \"success\": false, \"message\": \"The given data was invalid.\", \"errors\": { \"phone_number\": [\"The phone number field is required.\"] } }" }
          ]
        },
        {
          "name": "Check Warranty",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/warranty/check?code=GNV-ABC1234XYZ", "host": ["{{base_url}}"], "path": ["api", "warranty", "check"], "query": [{ "key": "code", "value": "GNV-ABC1234XYZ", "description": "warranty_code ATAU car_plate" }] }
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"data\": { \"id\": 1, \"warranty_code\": \"GNV-ABC1234XYZ\", \"car_plate\": \"B 1234 XY\", \"review_status\": \"approved\", \"has_owner\": true } }" },
            { "name": "404 Not Found", "code": 404, "body": "{ \"success\": false, \"message\": \"Nomor garansi atau plat nomor tidak ditemukan.\" }" }
          ]
        },
        {
          "name": "Download Warranty PDF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/warranty/download/GNV-ABC1234XYZ", "host": ["{{base_url}}"], "path": ["api", "warranty", "download", "GNV-ABC1234XYZ"] }
          },
          "response": [
            { "name": "200 OK (binary PDF)", "code": 200, "body": "<binary PDF stream>" },
            { "name": "403 Belum Disetujui", "code": 403, "body": "{ \"success\": false, \"message\": \"Sertifikat garansi ini belum disetujui dan belum bisa diunduh.\" }" }
          ]
        },
        {
          "name": "Claim Warranty (link to account)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/warranty/claim", "host": ["{{base_url}}"], "path": ["api", "warranty", "claim"] },
            "body": { "mode": "raw", "raw": "{\n  \"warranty_code\": \"GNV-ABC1234XYZ\"\n}" }
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"message\": \"Garansi berhasil dihubungkan ke akun Anda.\", \"points_awarded\": 100 }" },
            { "name": "409 Sudah Diklaim", "code": 409, "body": "{ \"success\": false, \"message\": \"Garansi ini sudah terhubung ke akun lain.\" }" }
          ]
        }
      ]
    },
    {
      "name": "Quotation & Inquiry",
      "item": [
        {
          "name": "Get Quotation Options",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/quotation/options", "host": ["{{base_url}}"], "path": ["api", "quotation", "options"] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"brands\": [\"Toyota\", \"Honda\"],\n    \"vehicles\": [ { \"id\": 1, \"brand\": \"Toyota\", \"model\": \"Avanza\", \"variant\": \"1.5 G\" } ],\n    \"products\": [ { \"id\": 1, \"name\": \"Nano-Ceramic\", \"product_type\": \"window_film\" } ]\n  }\n}" }]
        },
        {
          "name": "Submit Quotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/quotation/submit", "host": ["{{base_url}}"], "path": ["api", "quotation", "submit"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"customer_name\": \"Budi Santoso\",\n  \"customer_email\": \"budi@example.com\",\n  \"customer_phone\": \"081234567890\",\n  \"license_plate\": \"B 1234 XY\",\n  \"message\": \"Mau tanya harga kaca depan saja\",\n  \"items\": [ { \"film_product_id\": 1 } ]\n}"
            }
          },
          "response": [{ "name": "201 Created", "code": 201, "body": "{ \"success\": true, \"message\": \"Permintaan penawaran berhasil dikirim. Tim sales kami akan segera menghubungi Anda.\", \"data\": { \"quotation_number\": \"INQ-202607-AB12\" } }" }]
        },
        {
          "name": "Submit Product Inquiry (belum dijual)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/inquiry/submit", "host": ["{{base_url}}"], "path": ["api", "inquiry", "submit"] },
            "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Budi Santoso\",\n  \"customer_contact\": \"081234567890\",\n  \"message\": \"[Color Change Film] Tertarik warna matte black\"\n}" }
          },
          "response": [{ "name": "201 Created", "code": 201, "body": "{ \"success\": true, \"message\": \"Pertanyaan Anda berhasil dikirim. Tim kami akan segera menghubungi Anda.\", \"data\": { \"inquiry_number\": \"...\" } }" }]
        },
        {
          "name": "List Product Inquiries (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_token}}" }],
            "url": { "raw": "{{base_url}}/api/inquiry?status=new", "host": ["{{base_url}}"], "path": ["api", "inquiry"], "query": [{ "key": "status", "value": "new", "description": "opsional" }] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"success\": true, \"data\": { \"current_page\": 1, \"data\": [ { \"id\": 1, \"customer_name\": \"Budi\", \"customer_contact\": \"08123\", \"message\": \"...\", \"status\": \"new\" } ], \"per_page\": 20, \"total\": 5 } }" }]
        },
        {
          "name": "Submit Partnership Inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/partnership/submit", "host": ["{{base_url}}"], "path": ["api", "partnership", "submit"] },
            "body": { "mode": "raw", "raw": "{\n  \"applicant_name\": \"Budi Santoso\",\n  \"phone_number\": \"081234567890\",\n  \"email\": \"budi@example.com\",\n  \"city\": \"Jakarta\",\n  \"message\": \"Tertarik jadi dealer resmi\"\n}" }
          },
          "response": [{ "name": "201 Created", "code": 201, "body": "{ \"success\": true, \"message\": \"Pengajuan kemitraan berhasil dikirim. Tim kami akan segera menghubungi Anda.\", \"data\": { \"id\": 1, \"status\": \"new\" } }" }]
        }
      ]
    },
    {
      "name": "Customer — Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/customer/auth/request-otp", "host": ["{{base_url}}"], "path": ["api", "customer", "auth", "request-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"budi@example.com\"\n}" }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"message\": \"Kode verifikasi telah dikirim ke email Anda.\" }" }]
        },
        {
          "name": "Verify OTP (login/register)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/customer/auth/verify-otp", "host": ["{{base_url}}"], "path": ["api", "customer", "auth", "verify-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"budi@example.com\",\n  \"code\": \"123456\"\n}" }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"message\": \"Berhasil masuk.\", \"token\": \"eyJ0eXAiOiJKV1Qi...\", \"is_new\": false, \"data\": { \"id\": 1, \"email\": \"budi@example.com\", \"name\": \"Budi\", \"phone_number\": null } }" }]
        },
        {
          "name": "Me (current customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/api/customer/auth/me", "host": ["{{base_url}}"], "path": ["api", "customer", "auth", "me"] }
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"data\": { \"id\": 1, \"email\": \"budi@example.com\", \"name\": \"Budi\", \"phone_number\": \"08123\", \"loyalty_points\": 100 } }" },
            { "name": "401 Unauthenticated", "code": 401, "body": "{ \"success\": false, \"message\": \"Unauthenticated.\" }" }
          ]
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/customer/auth/profile", "host": ["{{base_url}}"], "path": ["api", "customer", "auth", "profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"phone_number\": \"081234567890\"\n}" }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"message\": \"Profil berhasil diperbarui.\", \"data\": { \"id\": 1, \"name\": \"Budi Santoso\", \"phone_number\": \"081234567890\" } }" }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/api/customer/auth/logout", "host": ["{{base_url}}"], "path": ["api", "customer", "auth", "logout"] }
          },
          "response": [{ "name": "200 OK", "code": 200, "body": "{ \"message\": \"Berhasil keluar.\" }" }]
        }
      ]
    },
